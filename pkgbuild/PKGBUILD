pkgname=wboard
pkgver=r3.65dbbc6
pkgrel=1
pkgdesc="A virtaul keyboard for Wayland."
url="https://github.com/hikmet517/wboard"
arch=('x86_64')
license=('GPL')
makedepends=('meson' 'python')
depends=('libxml2' 'wayland' 'libxkbcommon' 'cairo' 'pango')
source=("git+https://github.com/hikmet517/wboard.git")
md5sums=("SKIP")

pkgver() {
  cd "${pkgname}"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "${srcdir}/${pkgname}"
    meson setup build --prefix=/usr
    meson compile -C build
}

package() {
    cd "$srcdir/${pkgname}"
    meson install -C build --destdir "${pkgdir}"
}
